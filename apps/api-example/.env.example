# Server
PORT=3000
NODE_ENV=development

# Frontend URL — used for CORS, trusted origins, email links, and redirects
APP_URL=http://localhost:5173

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/keychain

# Auth secret (32+ chars) — signs tokens and encrypts queued emails
AUTH_SECRET=change-me-to-a-long-random-secret-of-32-chars

# Email (SMTP)
APP_NAME=Keychain
SUPPORT_CONTACT=support@keychain.test
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@localhost

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
