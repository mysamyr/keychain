{
  "name": "@mysamyr/ui",
  "version": "0.1.0-beta.1",
  "description": "Drop-in React UI components for Keychain",
  "author": "Mysamyr",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mysamyr/keychain.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Mysamyr/keychain/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/Mysamyr/keychain/issues"
  },
  "keywords": [
    "auth",
    "authentication",
    "self-hosted",
    "keychain",
    "react",
    "ui",
    "components"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --config tsdown.config.mjs && npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/global.css -o ./dist/styles.css --minify",
    "build:dev": "tsdown src/index.ts --format esm --dts --watch --config tsdown.config.mjs",
    "dev:css": "tailwindcss -i ./src/styles/global.css -o ./dist/styles.css --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@mysamyr/react": "0.1.0-beta.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
