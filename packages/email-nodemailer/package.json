{
  "name": "@mysamyr/email-nodemailer",
  "version": "0.1.0-beta.1",
  "description": "Nodemailer email adapter for Keychain",
  "author": "Mysamyr",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mysamyr/keychain.git",
    "directory": "packages/email-nodemailer"
  },
  "homepage": "https://github.com/Mysamyr/keychain/tree/main/packages/email-nodemailer#readme",
  "bugs": {
    "url": "https://github.com/Mysamyr/keychain/issues"
  },
  "keywords": [
    "auth",
    "authentication",
    "self-hosted",
    "keychain",
    "email",
    "nodemailer"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "build:dev": "tsdown src/index.ts --format esm --dts --clean --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@mysamyr/core": "0.1.0-beta.1",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2"
  }
}
