{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["packages/**/*", "apps/**/*"],
  "references": [
    { "path": "./packages/client/src/index.ts" },
    { "path": "./packages/core/src/index.ts" },
    { "path": "./packages/db-prisma/src/index.ts" },
    { "path": "./packages/email-nodemailer/src/index.ts" },
    { "path": "./packages/express/src/index.ts" },
    { "path": "./packages/react/src/index.ts" },
    { "path": "./packages/ui/src/index.ts" }
  ]
}
